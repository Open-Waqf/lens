{
  "name": "sahifah-lens",
  "private": true,
  "version": "1.0.0",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "test": "playwright test --project=phone --project=phone-ar",
    "test:all": "playwright test",
    "test:build": "npm run build && TEST_BUILD=1 playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:perf": "playwright test --project=desktop --grep @perf",
    "test:android": "node scripts/test-android.mjs",
    "test:no-telemetry": "node scripts/check-no-telemetry.mjs",
    "vault:verify": "node scripts/slbk-verify.mjs",
    "android:run": "node scripts/run-android.mjs",
    "android:live": "node scripts/run-android.mjs --live",
    "android:release": "node scripts/release-android.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/document-scanner": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "lit": "^3.3.3",
    "nanoid": "^6.0.2",
    "pdf-lib": "1.17.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^25.9.9",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
