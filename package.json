{
  "name": "sahifah-lens",
  "private": true,
  "version": "0.5.0",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "playwright test tests/e2e/perf-gates.spec.ts --project=\"Desktop Chrome\" --reporter=list",
    "test:security": "playwright test tests/e2e/privacy-network.spec.ts tests/e2e/offline-core.spec.ts --project=\"Desktop Chrome\" --reporter=list",
    "test:no-telemetry": "node scripts/check-no-telemetry.mjs",
    "test:full": "npm run build && npm run test:unit && npm run test:e2e",
    "vault:verify": "node scripts/slbk-verify.mjs",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "android:sync:win": "npm run build && npx cap sync android && node scripts/sync-android-win.mjs",
    "android:open:win": "npm run build && npx cap sync android && node scripts/sync-android-win.mjs --open"
  },
  "dependencies": {
    "@capacitor-mlkit/document-scanner": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "lit": "^3.3.3",
    "nanoid": "^6.0.2",
    "pdf-lib": "1.17.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^25.9.9",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
