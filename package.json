{
  "name": "sahifah-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:full": "npm run build && npm run test:unit && npm run test:e2e",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "android:sync:win": "npm run build && npx cap sync android && node scripts/sync-android-win.mjs",
    "android:open:win": "npm run build && npx cap sync android && node scripts/sync-android-win.mjs --open"
  },
  "dependencies": {
    "@capacitor-mlkit/document-scanner": "^8.0.1",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/camera": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capgo/capacitor-native-biometric": "8.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "4.3.0",
    "fflate": "0.8.2",
    "jszip": "3.10.1",
    "lit": "^3.3.2",
    "nanoid": "5.1.6",
    "pdf-lib": "1.17.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^8.1.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jszip": "3.4.1",
    "@types/node": "25.3.3",
    "@vitest/ui": "4.0.18",
    "jsdom": "28.1.0",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "4.0.18"
  }
}
